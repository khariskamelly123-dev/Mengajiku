                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins"
                        android:text="Materi"
                        android:textColor="@color/deep_sage"
                        android:textSize="14sp"
                        android:layout_marginEnd="8dp"/>
                    <ImageView
