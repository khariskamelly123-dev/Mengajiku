<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/cream"
    android:clipChildren="false"
    android:clipToPadding="false">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:layout_marginTop="15dp">

            <!-- BAGIAN HEADER (TEKS & GAMBAR) -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins"
                android:text="Assalamu'alaikum"
                android:textColor="@color/deep_sage"
                android:textSize="24sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Teks di sebelah kiri -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins"
                        android:text="Mari belajar mengaji!"
                        android:textColor="@color/deep_sage"
                        android:textSize="19sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="@font/poppins"
                        android:text="Perbarui bacaanmu mulai hari ini."
                        android:textColor="@color/deep_sage"
                        android:textSize="12sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/imgIlustrasi"
                    android:layout_width="148dp"
                    android:layout_height="123dp"
                    android:contentDescription="Ilustrasi belajar mengaji"
                    android:scaleType="centerInside"
                    android:src="@drawable/alquran_home" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:padding="15dp"
                android:fontFamily="@font/poppins"
                android:gravity="center"
                android:background="@drawable/bg_kotak_sage"
                android:text="Sebaik-baiknya kalian adalah orang yang belajar Al-Qur'an dan mengajarkannya&#10;(HR. Bukhari)"
                android:textColor="@color/deep_sage"
                android:textSize="15dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Pilihan Materi"
                android:textColor="@color/deep_sage"
                android:fontFamily="@font/poppins"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- ======================= -->
            <!-- BARIS PERTAMA (3 FITUR) -->
            <!-- ======================= -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <!-- Materi 1 -->
                <LinearLayout
                    android:id="@+id/btnHijaiyah"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_kotak_sage"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <!-- Taruh Icon di sini -->
                    <ImageView
                        android:id="@+id/iconHijaiyah"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/logo_hijaiyah"
                        android:contentDescription="Icon Hijaiyah" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Huruf Hijaiyah"
                        android:textAlignment="center"
                        android:textColor="@color/deep_sage"
                        android:fontFamily="@font/poppins"
                        android:textStyle="bold"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Materi 2 -->
                <LinearLayout
                    android:id="@+id/btnHarakat"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_kotak_kuningmuda"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <!-- Taruh Icon di sini -->
                    <ImageView
                        android:id="@+id/iconHarakat"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/logo_harakat"
                        android:contentDescription="Icon Harakat" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Harakat"
                        android:textAlignment="center"
                        android:textColor="@color/deep_sage"
                        android:fontFamily="@font/poppins"
                        android:textStyle="bold"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Materi 3 -->
                <LinearLayout
                    android:id="@+id/btnTajwid"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/bg_kotak_sage"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <!-- Taruh Icon di sini -->
                    <ImageView
                        android:id="@+id/iconTajwid"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/logo_tajwid"
                        android:contentDescription="Icon Tajwid" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Tajwid"
                        android:textAlignment="center"
                        android:textColor="@color/deep_sage"
                        android:fontFamily="@font/poppins"
                        android:textStyle="bold"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- ======================= -->
            <!-- BARIS KEDUA (3 FITUR)   -->
            <!-- ======================= -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <!-- Materi 4 -->
                <LinearLayout
                    android:id="@+id/btnGharib"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_kotak_kuningmuda"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <!-- Taruh Icon di sini -->
                    <ImageView
                        android:id="@+id/iconGharib"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/logo_ghorib"
                        android:contentDescription="Icon Gharib" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Ghorib"
                        android:textAlignment="center"
                        android:textColor="@color/deep_sage"
                        android:fontFamily="@font/poppins"
                        android:textStyle="bold"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Materi 5 (Contoh Ayat) -->
                <LinearLayout
                    android:id="@+id/btnContohAyat"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_kotak_sage"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <!-- Taruh Icon di sini -->
                    <ImageView
                        android:id="@+id/iconContohAyat"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/logo_contoh_ayat"
                        android:contentDescription="Icon Contoh Ayat" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Contoh Ayat"
                        android:textAlignment="center"
                        android:textColor="@color/deep_sage"
                        android:fontFamily="@font/poppins"
                        android:textStyle="bold"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Materi 6 (Kuis) -->
                <LinearLayout
                    android:id="@+id/btnLatihan"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/bg_kotak_kuningmuda"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <!-- Taruh Icon di sini -->
                    <ImageView
                        android:id="@+id/iconKuis"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/logo_kuis"
                        android:contentDescription="Icon Kuis" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Kuis"
                        android:textAlignment="center"
                        android:textColor="@color/deep_sage"
                        android:fontFamily="@font/poppins"
                        android:textStyle="bold"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Navigasi bawah -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:background="@drawable/bg_kotak_kuningmuda"
        android:layout_marginBottom="5dp"
        android:elevation="8dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- Tombol Beranda -->
        <LinearLayout
            android:id="@+id/navBeranda"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <ImageView
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:contentDescription="Beranda"
                android:src="@drawable/logo_home" />
        </LinearLayout>

        <!-- Tombol Latihan -->
        <LinearLayout
            android:id="@+id/navLatihan"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:clipChildren="false"
            android:clipToPadding="false">

            <ImageView
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:background="@drawable/bg_lingkaran_sage"
                android:contentDescription="Latihan"
                android:src="@drawable/logo_latihan"
                android:elevation="10dp"
                android:translationY="-30dp" />
        </LinearLayout>

        <!-- Tombol Profil -->
        <LinearLayout
            android:id="@+id/navProfil"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <ImageView
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:contentDescription="Profil"
                android:src="@drawable/logo_profil" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>