<!-- Navigasi bawah -->
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:orientation="horizontal"
    android:background="@drawable/bg_kotak_kuningmuda"
    android:layout_marginBottom="5dp"
    android:elevation="8dp"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Tombol Beranda -->
    <LinearLayout
        android:id="@+id/navBeranda"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground">

        <ImageView
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:contentDescription="Beranda"
            android:src="@drawable/logo_home" />
    </LinearLayout>

    <!-- Tombol Latihan -->
    <LinearLayout
        android:id="@+id/navLatihan"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:clipChildren="false"
        android:clipToPadding="false">

        <ImageView
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:background="@drawable/bg_lingkaran_sage"
            android:contentDescription="Latihan"
            android:src="@drawable/logo_latihan"
            android:elevation="10dp"
            android:translationY="-30dp" />
    </LinearLayout>

    <!-- Tombol Profil -->
    <LinearLayout
        android:id="@+id/navProfil"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground">

        <ImageView
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:contentDescription="Profil"
            android:src="@drawable/logo_profil" />
    </LinearLayout>

</LinearLayout>